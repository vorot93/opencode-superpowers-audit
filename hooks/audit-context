#!/bin/sh
# Claude Code hook: adds superpowers-audit context when a routed skill loads.
#
# Claude Code runs this for every Skill load, typed slash command, and
# compaction, so it must never block one: every path exits 0, and anything
# unexpected (no plugin root, a missing file, unrecognized input) emits nothing.
# Claude Code guarantees no runtime beyond POSIX sh and stock utilities.
#
# The hook input, content, and option values stay in pipes and awk, never in
# shell variables: dash 0.5.13 in the C locale corrupts non-ASCII bytes on
# variable assignment, and typed prompts carry the user's own text. Only the
# extracted route is held in one.

trap 'exit 0' EXIT
LC_ALL=C
export LC_ALL

# route: EVENT:SUBJECT for the hook input on standard input, where SUBJECT names
# what fired the event (tool_input.skill, command_name, or source); nothing for
# another event or a missing subject. Values keep their escapes as written. The
# scan tracks strings and nesting, so a key of the same name inside a string, an
# array, or another object (a tool_response, say) never matches. Splitting on
# quotes keeps it linear; a piece ending in an odd run of backslashes ends at an
# escaped quote, so the string continues.
route() {
  awk '
    function subject_path(event) {
      if (event == "PostToolUse") return "tool_input.skill"
      if (event == "UserPromptExpansion") return "command_name"
      if (event == "SessionStart") return "source"
      return ""
    }
    # Records the value at each wanted path, first occurrence only; returns
    # once the event and its subject are both known.
    function scan(json,   count, piece, p, i, c, text, inside, depth, container, key, previous, at, d) {
      count = split(json, piece, "\"")
      depth = 0; inside = 0
      for (p = 1; p <= count; p++) {
        if (inside) {
          text = text piece[p]
          if (piece[p] ~ /(^|[^\\])(\\\\)*\\$/) { text = text "\""; continue }
          inside = 0
          if (container[depth] == "{" && (previous == "{" || previous == ",")) {
            key[depth] = text
            previous = "key"
            continue
          }
          if (container[depth] == "{" && previous == ":") {
            at = key[1]
            for (d = 2; d <= depth; d++) at = at "." key[d]
            if (at in wanted && !(at in value)) {
              value[at] = text
              if (("hook_event_name" in value) && (subject_path(value["hook_event_name"]) in value)) return
            }
          }
          previous = "value"
          continue
        }
        for (i = 1; i <= length(piece[p]); i++) {
          c = substr(piece[p], i, 1)
          if (c == "{" || c == "[") { container[++depth] = c; key[depth] = ""; previous = c }
          else if (c == "}" || c == "]") { depth--; previous = "value" }
          else if (c == ":" || c == ",") previous = c
          else if (c !~ /[ \t\r]/) previous = "value"
        }
        inside = 1; text = ""
      }
    }
    { json = json " " $0 }
    END {
      split("hook_event_name tool_input.skill command_name source", names, " ")
      for (n in names) wanted[names[n]] = 1
      scan(json)
      event = value["hook_event_name"]
      subject = subject_path(event)
      if (subject != "" && subject in value) print event ":" value[subject]
    }'
}

# escape(s): s as the contents of a JSON string, as JSON.stringify writes it.
escape_function='
  function escape(s,   out, i, c) {
    if (!("\001" in control)) for (i = 1; i < 32; i++) control[sprintf("%c", i)] = sprintf("\\u%04x", i)
    out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\" || c == "\"") out = out "\\" c
      else if (c == "\n") out = out "\\n"
      else if (c == "\t") out = out "\\t"
      else if (c == "\r") out = out "\\r"
      else if (c in control) out = out control[c]
      else out = out c
    }
    return out
  }'

# emit EVENT: standard input, exactly, as EVENT's additional context. The
# appended newline terminates the last line, so a final newline survives.
emit() {
  { cat; printf '\n'; } | awk -v event="$1" "$escape_function"'
    { context = context (NR > 1 ? "\\n" : "") escape($0) }
    END {
      if (context != "")
        printf "{\"hookSpecificOutput\":{\"hookEventName\":\"%s\",\"additionalContext\":\"%s\"}}\n", event, context
    }'
}

# configuration: the block renderConfiguration (src/skill.ts) renders for the
# same options. Claude Code exports only the options the user set and joins the
# reviewers list with commas; each entry splits at its first `=`. Neither
# character may appear in a writer or reviewer, so no entry is ambiguous. The
# rules mirror src/options.ts and are tested against the same vectors. An empty
# reviewers list has no entries.
configuration() {
  awk "$escape_function"'
    function fail(message) { errors = errors (errors == "" ? "" : "\n") message }
    BEGIN {
      writer_pattern = "^[^[:space:]/#,=]+/[^[:space:]#,=]+$"
      reviewer_pattern = "^[^[:space:]/#,=]+/[^[:space:]#,=]+(#[^[:space:]#,=]+)?$"
      list = ENVIRON["CLAUDE_PLUGIN_OPTION_REVIEWERS"]
      count = (list == "") ? 0 : split(list, entries, ",")
      for (i = 1; i <= count; i++) {
        separator = index(entries[i], "=")
        writer = substr(entries[i], 1, separator - 1)
        reviewer = substr(entries[i], separator + 1)
        if (separator == 0 || writer !~ writer_pattern || reviewer !~ reviewer_pattern)
          fail("reviewers: entry \"" entries[i] "\" is not writer-provider/model=reviewer-provider/model[#variant]")
        else if (writer in seen)
          fail("reviewers: writer \"" writer "\" is mapped more than once")
        else {
          seen[writer] = 1
          pairs = pairs (pairs == "" ? "" : ",\n") "        \"" escape(writer) "\": \"" escape(reviewer) "\""
        }
      }

      rounds = "5"
      if ("CLAUDE_PLUGIN_OPTION_MAXROUNDS" in ENVIRON) rounds = ENVIRON["CLAUDE_PLUGIN_OPTION_MAXROUNDS"]
      if (rounds !~ /^[1-9][0-9]*$/) fail("maxRounds: \"" rounds "\" is not a positive integer")

      if ("CLAUDE_PLUGIN_OPTION_ARTIFACTDIRECTORY" in ENVIRON) {
        directory = ENVIRON["CLAUDE_PLUGIN_OPTION_ARTIFACTDIRECTORY"]
        sub(/^[[:space:]]+/, "", directory)
        sub(/[[:space:]]+$/, "", directory)
        if (directory == "") fail("artifactDirectory: must not be blank")
      }

      if (errors != "") {
        printf "## Configuration error\n\nRequest correction from the human before auditor dispatch. Do not use fallback defaults.\n\n"
        printf "    {\n      \"message\": \"%s\"\n    }", escape(errors)
      } else {
        printf "## Configuration\n\n    {\n"
        if (pairs == "") printf "      \"reviewers\": {},\n"
        else printf "      \"reviewers\": {\n%s\n      },\n", pairs
        printf "      \"maxRounds\": %s", rounds
        if (directory != "") printf ",\n      \"artifactDirectory\": \"%s\"", escape(directory)
        printf "\n    }"
      }
    }'
}

[ -n "${CLAUDE_PLUGIN_ROOT:-}" ] || exit 0
route=$(route)
event=${route%%:*}

case $route in
  PostToolUse:superpowers-audit:superpowers-audit)
    reference=$CLAUDE_PLUGIN_ROOT/skills/superpowers-audit/references/claude-code.md
    [ -r "$reference" ] || exit 0
    { cat "$reference"; printf '\n'; configuration; } | emit "$event"
    ;;
  # Superpowers authoring skills, loaded by the Skill tool or typed: the stages
  # this plugin adds beside the unchanged upstream body.
  PostToolUse:superpowers:brainstorming | UserPromptExpansion:superpowers:brainstorming | \
  PostToolUse:superpowers:writing-plans | UserPromptExpansion:superpowers:writing-plans)
    amendment=$CLAUDE_PLUGIN_ROOT/integration/claude-code/${route##*:}.md
    [ -r "$amendment" ] || exit 0
    emit "$event" < "$amendment"
    ;;
  # Compaction re-attaches invoked skill bodies but not hook output, so point
  # the writer back at the skills whose context was lost.
  SessionStart:compact)
    pointer=$CLAUDE_PLUGIN_ROOT/integration/claude-code/compact.md
    [ -r "$pointer" ] || exit 0
    emit "$event" < "$pointer"
    ;;
esac
